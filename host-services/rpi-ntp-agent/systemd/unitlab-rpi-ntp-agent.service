[Unit]
Description=UnitLab RPi NTP Agent (Chrony manager)
After=network-online.target chrony.service chronyd.service redis.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/unitlab/rpi-ntp-agent
EnvironmentFile=-/etc/unitlab/rpi-ntp-agent.env
ExecStart=/opt/unitlab/rpi-ntp-agent/.venv/bin/python -m unitlab_rpi_ntp_agent
Restart=always
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

