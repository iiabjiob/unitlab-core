{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@workspace/menu-core": ["../menu-core/src/index.ts"],
      "@workspace/menu-vue": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
