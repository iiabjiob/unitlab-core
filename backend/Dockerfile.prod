# ---------------------------------------------------------
# Stage 1: Builder (RPi5-friendly)
# ---------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    curl git build-essential cmake libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Copy sources FIRST (important!)
COPY backend/ .
COPY iec61850_ied /tmp/iec61850_ied

# Build UnitLab's own native MMS client. The default build intentionally does
# not link libIEC61850; external IED discovery uses this native wire client.
RUN cmake -S /tmp/iec61850_ied -B /tmp/iec61850_ied-build \
      -DUNITLAB_IEC61850_SIM_WITH_LIBIEC61850=OFF \
    && cmake --build /tmp/iec61850_ied-build --target unitlab-iec61850-ied-sim -j"$(nproc)"

# Create venv and install prod deps
RUN uv venv && . .venv/bin/activate \
    && uv sync --frozen --no-dev


# ---------------------------------------------------------
# Stage 2: Runtime (small, secure)
# ---------------------------------------------------------
FROM python:3.11-slim-bookworm AS runtime

RUN apt-get update && apt-get install -y curl libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    IEC61850_IED_LIVE_WIRE_BINARY_PATH=/opt/unitlab/bin/unitlab-iec61850-ied-sim

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /tmp/iec61850_ied-build/unitlab-iec61850-ied-sim /opt/unitlab/bin/unitlab-iec61850-ied-sim

# Copy application code
COPY backend/ .

RUN adduser --disabled-password --gecos "" appuser \
    && chown -R appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--loop", "uvloop", \
     "--http", "httptools"]
